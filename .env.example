# Environment variables
# Copy to `.env.local` for local development. Set the same names in Vercel
# and in Cursor Cloud secrets. Never commit real values.

# Public site origin used for canonical URLs and origin checks (server-only).
SITE_URL=https://oliverpartyexpert.com

# Supabase (server-only). Do not prefix with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Resend (server-only).
RESEND_API_KEY=
RESEND_FROM_EMAIL=Oliver Party Expert <oliverpartyofficial@gmail.com>
CONTACT_TO_EMAIL=oliverpartyofficial@gmail.com

# Cloudflare Turnstile (recommended in production). When both are set, captcha
# is enforced before Supabase/Resend. Site key is the only NEXT_PUBLIC_ value.
# Local/CI dummy always-pass keys:
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
# TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
